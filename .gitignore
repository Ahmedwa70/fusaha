# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
/poc/runtime-persistence/integration-environment/.env.integration
.env
.env.local
.env.backup
.env.staging.local
.env.********.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.playwright-mcp/
.trigger
# Local environment backups
.env.local.backup*

# Local Cloudflare R2 credentials for the library bucket (never commit)
.env.library-r2.local

# Owner-level production credentials for the pre-launch backup (never commit)
.env.production-owner.local

# Local database backups (must never enter the repo)
backups/
